    {
        "id": "n_api_pass_lim",
        "type": "function",
        "z": "tab_semaforo",
        "name": "limite (padrão 10)",
        "func": "const n = parseInt(msg.req.query.limite, 10);\nmsg.params = { $limite: Number.isFinite(n) && n > 0 ? Math.min(n, 200) : 10 };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 760,
        "wires": [
            [
                "n_api_pass_sql"
            ]
        ]
    },
    {
        "id": "n_api_pass_sql",
        "type": "sqlite",
        "z": "tab_semaforo",
        "mydb": "cfg_sqlite",
        "sqlquery": "prepared",
        "sql": "SELECT id, registrado_em, placa, sinal, sinal = 'VERMELHO' AS infracao FROM passagens ORDER BY id DESC LIMIT $limite",
        "name": "Últimas passagens",
