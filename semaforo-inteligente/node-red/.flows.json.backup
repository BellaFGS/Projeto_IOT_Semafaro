                "n_api_est_sql"
            ]
        ]
    },
    {
        "id": "n_api_est_sql",
        "type": "sqlite",
        "z": "tab_semaforo",
        "mydb": "cfg_sqlite",
        "sqlquery": "fixed",
        "sql": "SELECT COUNT(*) AS total, COALESCE(SUM(sinal = 'VERDE'), 0) AS verde, COALESCE(SUM(sinal = 'AMARELO'), 0) AS amarelo, COALESCE(SUM(sinal = 'VERMELHO'), 0) AS infracoes, (SELECT COUNT(*) FROM passagens WHERE date(registrado_em, 'localtime') = date('now', 'localtime')) AS passagens_hoje, (SELECT COUNT(*) FROM passagens WHERE sinal = 'VERMELHO' AND date(registrado_em, 'localtime') = date('now', 'localtime')) AS infracoes_hoje FROM passagens",
        "name": "Estatísticas",
        "x": 360,
        "y": 880,
        "wires": [
            [
                "n_api_est_first"
            ]
        ]
    },
    {
        "id": "n_api_est_first",
        "type": "function",
        "z": "tab_semaforo",
        "name": "primeira linha",
        "func": "msg.payload = (msg.payload && msg.payload[0]) || {};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
