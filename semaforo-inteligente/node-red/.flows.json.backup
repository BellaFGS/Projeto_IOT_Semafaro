[
    {
        "id": "tab_semaforo",
        "type": "tab",
        "label": "Semáforo Inteligente",
        "disabled": false,
        "info": "Dois sistemas: (1) semáforo Wokwi → MQTT → dashboard; (2) carros do dashboard → passagem → SQLite → dashboard e ESP32."
