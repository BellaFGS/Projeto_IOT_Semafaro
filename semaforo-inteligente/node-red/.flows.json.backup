    {
        "id": "c_sem",
        "type": "comment",
        "z": "tab_semaforo",
        "name": "3. SEMÁFORO (Wokwi → dashboard): LEDs, tempos, botão e status do ESP32",
        "info": "",
        "x": 290,
        "y": 260,
        "wires": []
    },
    {
        "id": "n_mqtt_in",
        "type": "mqtt in",
        "z": "tab_semaforo",
        "name": "ESP32",
        "topic": "fatec/semaforo/01/#",
        "qos": "0",
        "datatype": "json",
        "broker": "cfg_broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 110,
        "y": 320,
        "wires": [
            [
                "n_sem",
                "n_sw_esp32"
            ]
        ]
    },
    {
        "id": "n_sem",
        "type": "function",
        "z": "tab_semaforo",
        "name": "Estado do semáforo",
        "func": "// Estado do semáforo (sistema 1: Wokwi → dashboard)\n// Recebe o ESP32 por MQTT, guarda o estado em flow.semaforo e monta a telemetria.\n// Saída 1 → dashboard (websocket /ws/semaforo)\n// Saída 2 → passagem detectada pelo HC-SR04 do próprio Wokwi (slider do sensor)\nconst BASE = 'fatec/semaforo/01';\nconst T = {\n    state: BASE + '/estado',\n    status: BASE + '/status',\n    button: BASE + '/sensor/botao',\n    vehicle: BASE + '/sensor/veiculo',\n};\nconst WEAK_SIGNAL_DBM = -80;\n\nconst s = flow.get('semaforo') || {\n    light: 'RED', remainingS: 0, durationS: 0, pedestrianRequest: false, times: null,\n    online: false, wifiRssi: -100, uptimeS: 0, hasState: false,\n};\nconst p = (typeof msg.payload === 'object' && msg.payload) || {};\nlet passage = null;\n\nswitch (msg.topic) {\n    case T.state:\n        s.light = p.light ?? s.light;\n        s.remainingS = Number(p.remainingS ?? s.remainingS);\n        s.durationS = Number(p.durationS ?? s.durationS);\n        s.pedestrianRequest = Boolean(p.pedestrianRequest);\n        if (p.tempos) s.times = p.tempos;\n        s.online = true;\n        s.hasState = true;\n        break;\n    case T.status:\n        s.online = Boolean(p.online);\n        if (p.wifiRssi !== undefined) s.wifiRssi = Number(p.wifiRssi);\n        if (p.uptimeS !== undefined) s.uptimeS = Number(p.uptimeS);\n        break;\n    case T.button:\n        if (p.pressed) s.pedestrianRequest = true;\n        break;\n    case T.vehicle:\n        // Carro \"passado\" no slider do HC-SR04 dentro do Wokwi\n        passage = { payload: { placa: 'WOKWI', sinal: s.light, origem: 'wokwi' } };\n        break;\n    default:\n        return null; // comandos (cmd/...) e outros tópicos\n}\nflow.set('semaforo', s);\n\nlet mode = 'AUTOMATICO';\nif (!s.online) mode = 'ATENCAO';\nelse if (s.pedestrianRequest) mode = 'PEDESTRE';\n\nconst alerts = [];\nif (!s.online) alerts.push({ level: 'critical', code: 'DISPOSITIVO_OFFLINE', message: 'ESP32 sem comunicação com o broker MQTT' });\nif (s.pedestrianRequest) alerts.push({ level: 'info', code: 'PEDESTRE_AGUARDANDO', message: 'Pedestre aguardando travessia' });\nif (s.online && s.wifiRssi < WEAK_SIGNAL_DBM) alerts.push({ level: 'warning', code: 'SINAL_FRACO', message: 'Wi-Fi fraco no ESP32 (' + s.wifiRssi + ' dBm)' });\n\nnode.status({ fill: s.online ? 'green' : 'red', shape: 'dot', text: s.light + ' ' + s.remainingS + 's · ' + mode });\nif (!s.hasState) return [null, passage];\n\nconst transito = flow.get('transito') || { total: 0, green: 0, yellow: 0, red: 0, perMin: 0, last: null };\nconst telemetry = {\n    type: 'telemetry',\n    deviceId: 'esp32-semaforo-01',\n    timestamp: new Date().toISOString(),\n    light: { state: s.light, remainingS: s.remainingS, durationS: s.durationS },\n    times: s.times,\n    mode,\n    pedestrianRequest: s.pedestrianRequest,\n    actuators: { ledRed: s.light === 'RED', ledYellow: s.light === 'YELLOW', ledGreen: s.light === 'GREEN' },\n    device: { online: s.online, wifiRssi: s.wifiRssi, uptimeS: s.uptimeS },\n    alerts,\n    passages: { total: transito.total, green: transito.green, yellow: transito.yellow, red: transito.red, perMin: transito.perMin },\n    lastPassage: transito.last,\n};\nreturn [{ payload: telemetry }, passage];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 320,
        "wires": [
            [
                "n_ws_out",
                "n_debug_tel"
            ],
            [
                "n_validate"
            ]
        ]
    },
