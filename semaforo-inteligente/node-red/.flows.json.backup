            ]
        ]
    },
    {
        "id": "n_cmd",
        "type": "function",
        "z": "tab_semaforo",
        "name": "Comandos do dashboard",
        "func": "// Comandos do dashboard (o que chega pelo WebSocket /ws/semaforo)\n//   {\"type\":\"botao_virtual\"}                                clique no botão de pedestre do poste\n//   {\"type\":\"passagem\",\"placa\":\"2\",\"sinal\":\"RED\"}           carro do minigame passou pelo sensor\n// Saída 1 → MQTT para o ESP32 (botão)   Saída 2 → registrar passagem no banco\nconst BASE = 'fatec/semaforo/01';\nlet cmd;\ntry {\n    cmd = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n} catch (e) {\n    return null;\n}\nif (!cmd || typeof cmd !== 'object') return null;\n\nif (cmd.type === 'botao_virtual') {\n    node.status({ fill: 'blue', shape: 'ring', text: 'botão de pedestre (' + new Date().toLocaleTimeString('pt-BR') + ')' });\n    return [{ topic: BASE + '/cmd/botao_virtual', payload: { pressed: true } }, null];\n}\nif (cmd.type === 'passagem') {\n    const placa = String(cmd.placa || '').trim().slice(0, 12) || '?';\n    node.status({ fill: 'yellow', shape: 'dot', text: 'carro ' + placa + ' no sensor' });\n    return [null, { payload: { placa, sinal: cmd.sinal, origem: 'dashboard' } }];\n}\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 480,
        "wires": [
            [
                "n_btn_out",
                "n_debug_btn"
            ],
            [
                "n_validate"
            ]
        ]
    },
    {
        "id": "n_btn_out",
        "type": "mqtt out",
        "z": "tab_semaforo",
        "name": "Botão → ESP32",
        "topic": "",
        "qos": "0",
        "retain": "false",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "cfg_broker",
        "x": 620,
        "y": 460,
        "wires": []
    },
    {
        "id": "n_validate",
        "type": "function",
        "z": "tab_semaforo",
        "name": "Validar passagem",
        "func": "// Validar passagem (antes de gravar no banco)\n// Entrada: { placa, sinal (o que o dashboard via), origem }\n// Saída 1 → passagem válida, já com o sinal OFICIAL do ESP32\n// Saída 2 → passagem recusada, com o motivo (vai para o debug)\nconst PLACAS = ['1', '2', '3', 'WOKWI'];\nconst JANELA_DUPLICADA_MS = 3000;\nconst p = msg.payload || {};\nconst placa = String(p.placa || '').trim().toUpperCase();\nconst recusar = motivo => {\n    node.status({ fill: 'red', shape: 'ring', text: 'recusada: ' + motivo });\n    return [null, { payload: { placa, motivo, recebido: p } }];\n};\n\n// 1. Placa conhecida\nif (!PLACAS.includes(placa)) return recusar('placa inválida');\n\n// 2. Verificação com o semáforo: o ESP32 precisa estar online e com estado conhecido\nconst s = flow.get('semaforo');\nif (!s || !s.hasState) return recusar('semáforo sem estado (Wokwi não iniciado)');\nif (!s.online) return recusar('ESP32 offline');\n\n// 3. Mesma placa em menos de 3 s = leitura duplicada do sensor\nconst ultimas = context.get('ultimas') || {};\nconst agora = Date.now();\nif (ultimas[placa] && agora - ultimas[placa] < JANELA_DUPLICADA_MS) return recusar('duplicada');\nultimas[placa] = agora;\ncontext.set('ultimas', ultimas);\n\n// Sinal oficial = último estado publicado pelo ESP32 (não o que o dashboard mandou)\nconst divergente = p.sinal && p.sinal !== s.light;\nnode.status({ fill: 'green', shape: 'dot', text: 'ok: carro ' + placa + ' no ' + s.light + (divergente ? ' (dashboard viu ' + p.sinal + ')' : '') });\nreturn [{ payload: { placa, light: s.light, origem: p.origem || 'dashboard' } }, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 520,
        "wires": [
            [
                "n_register"
            ],
            [
                "n_debug_rej"
            ]
        ]
    },
    {
        "id": "n_debug_rej",
        "type": "debug",
        "z": "tab_semaforo",
        "name": "passagens recusadas",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 840,
        "y": 580,
        "wires": []
    },
    {
        "id": "n_register",
        "type": "function",
        "z": "tab_semaforo",
        "name": "Registrar passagem",
        "func": "// Registrar passagem: monta o INSERT com os dados já validados\nconst PT = { GREEN: 'VERDE', YELLOW: 'AMARELO', RED: 'VERMELHO' };\nconst ts = new Date().toISOString();\nmsg.passagem = { placa: msg.payload.placa, light: msg.payload.light, origem: msg.payload.origem };\nmsg.topic = 'INSERT INTO passagens (registrado_em, placa, sinal) VALUES ($1, $2, $3)';\nmsg.payload = [ts, msg.payload.placa, PT[msg.payload.light]];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
        "y": 520,
        "wires": [
            [
                "n_insert"
            ]
        ]
    },
    {
        "id": "n_insert",
        "type": "sqlite",
        "z": "tab_semaforo",
        "mydb": "cfg_sqlite",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "Gravar no banco",
        "x": 1030,
        "y": 520,
        "wires": [
            [
                "n_stats_q"
            ]
        ]
    },
    {
        "id": "n_stats_q",
        "type": "function",
        "z": "tab_semaforo",
        "name": "Consultar totais",
        "func": "// Totais do banco (depois de cada passagem e ao iniciar)\nmsg.topic = \"SELECT COUNT(*) AS total, COALESCE(SUM(sinal = 'VERDE'), 0) AS verde, COALESCE(SUM(sinal = 'AMARELO'), 0) AS amarelo, COALESCE(SUM(sinal = 'VERMELHO'), 0) AS vermelho, (SELECT COUNT(*) FROM passagens WHERE registrado_em >= strftime('%Y-%m-%dT%H:%M:%fZ', 'now', '-60 seconds')) AS por_min, (SELECT id FROM passagens ORDER BY id DESC LIMIT 1) AS ultimo_id, (SELECT registrado_em FROM passagens ORDER BY id DESC LIMIT 1) AS ultimo_em, (SELECT placa FROM passagens ORDER BY id DESC LIMIT 1) AS ultima_placa, (SELECT sinal FROM passagens ORDER BY id DESC LIMIT 1) AS ultimo_sinal FROM passagens\";\nmsg.payload = [];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1220,
        "y": 520,
        "wires": [
            [
                "n_stats"
            ]
        ]
    },
    {
        "id": "n_stats",
        "type": "sqlite",
        "z": "tab_semaforo",
        "mydb": "cfg_sqlite",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "Totais",
        "x": 1390,
        "y": 520,
        "wires": [
            [
                "n_after"
            ]
        ]
    },
    {
        "id": "n_after",
        "type": "function",
        "z": "tab_semaforo",
        "name": "Avisar dashboard e ESP32",
        "func": "// Guarda os totais em flow.transito e avisa as duas pontas\n// Saída 1 → dashboard (evento \"passagem\")   Saída 2 → ESP32 (buzzer + Serial)\n// Saída 3 → debug: a linha como ficou gravada na tabela passagens\nconst BASE = 'fatec/semaforo/01';\nconst EN = { VERDE: 'GREEN', AMARELO: 'YELLOW', VERMELHO: 'RED' };\nconst r = (msg.payload && msg.payload[0]) || {};\nconst last = r.ultimo_id ? {\n    id: r.ultimo_id,\n    at: r.ultimo_em,\n    plate: r.ultima_placa,\n    light: EN[r.ultimo_sinal],\n    violation: r.ultimo_sinal === 'VERMELHO',\n} : null;\nconst transito = {\n    total: r.total || 0, green: r.verde || 0, yellow: r.amarelo || 0, red: r.vermelho || 0,\n    perMin: r.por_min || 0, last,\n};\nflow.set('transito', transito);\nnode.status({ fill: 'blue', shape: 'dot', text: transito.total + ' passagens · ' + transito.red + ' infrações' });\n\nif (!msg.passagem || !last) return null; // carga inicial ao iniciar o Node-RED\nreturn [\n    { payload: { type: 'passagem', passage: last, stats: transito } },\n    { topic: BASE + '/cmd/passagem', payload: { placa: last.plate, sinal: last.light, infracao: last.violation } },\n    { topic: 'passagens', payload: { id: r.ultimo_id, registrado_em: r.ultimo_em, placa: r.ultima_placa, sinal: r.ultimo_sinal } },\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1180,
        "y": 600,
        "wires": [
